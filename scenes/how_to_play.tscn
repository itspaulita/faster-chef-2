[sub_resource type="Theme" id="Theme_how"]
default_font = ExtResource("2_font")
default_font_size = 28
Label/colors/font_color = Color(0.17, 0.09, 0.06, 1)
Button/colors/font_color = Color(0.17, 0.09, 0.06, 1)
Button/colors/font_hover_color = Color(0.17, 0.09, 0.06, 1)
Button/colors/font_pressed_color = Color(0.17, 0.09, 0.06, 1)
Button/colors/font_focus_color = Color(0.17, 0.09, 0.06, 1)
Button/font_sizes/font_size = 36
Button/styles/normal = SubResource("StyleBoxFlat_btn")
Button/styles/hover = SubResource("StyleBoxFlat_btn_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_btn")
Button/styles/focus = SubResource("StyleBoxFlat_btn_hover")

[node name="HowToPlay" type="CanvasLayer"]
layer = 10
script = ExtResource("1_how")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="Dim"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Banner" type="PanelContainer" parent="Dim/Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(1500, 0)
layout_mode = 2
theme = SubResource("Theme_how")
theme_override_styles/panel = SubResource("StyleBoxFlat_banner")

[node name="V" type="VBoxContainer" parent="Dim/Center/Banner"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Dim/Center/Banner/V"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.5, 0.1, 1)
theme_override_colors/font_outline_color = Color(0.23, 0.12, 0.08, 1)
theme_override_constants/outline_size = 12
theme_override_font_sizes/font_size = 60
text = "HOW TO PLAY"
horizontal_alignment = 1

[node name="Goal" type="Label" parent="Dim/Center/Banner/V"]
custom_minimum_size = Vector2(1400, 0)
layout_mode = 2
text = "Cook the monster's order, no fighting needed! Each level is one dish in 3 phases."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Phase1" type="Label" parent="Dim/Center/Banner/V"]
custom_minimum_size = Vector2(1400, 0)
layout_mode = 2
text = "1. GATHER  Run and jump to collect every ingredient piece. Dodge the cats, they steal your food! Fill the bars to open the way out."
autowrap_mode = 3

[node name="Phase2" type="Label" parent="Dim/Center/Banner/V"]
custom_minimum_size = Vector2(1400, 0)
layout_mode = 2
text = "2. CHOP AND COOK  Stand at the board and press E to chop each ingredient 3 times. Carry it to the pot with Q, in recipe order. When all 3 are in, the pot cooks by itself. Take the pot to the plating station."
autowrap_mode = 3

[node name="Phase3" type="Label" parent="Dim/Center/Banner/V"]
custom_minimum_size = Vector2(1400, 0)
layout_mode = 2
text = "3. DELIVER  Pick up the plated dish and bring it to the monster. Fresher food earns a better grade!"
autowrap_mode = 3

[node name="Controls" type="Label" parent="Dim/Center/Banner/V"]
custom_minimum_size = Vector2(1400, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.12, 0.45, 0.45, 1)
text = "MOVE: A / D or arrows     JUMP: Space     CHOP: E     GRAB / DROP: Q     PAUSE: Esc"
horizontal_alignment = 1
autowrap_mode = 3

[node name="CloseButton" type="Button" parent="Dim/Center/Banner/V"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
text = "GOT IT!"
